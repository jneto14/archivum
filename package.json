{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "archivum",
    "description": "Open-source document management system focused on organizing physical documents and their digital representations.",
    "private": true,
    "license": "Elastic-2.0",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint . --max-warnings=0",
        "test": "vitest run",
        "test:watch": "vitest",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@eslint-react/eslint-plugin": "^5.28.0",
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@rolldown/plugin-babel": "^0.2.4",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.5",
        "@typescript/native": "npm:typescript@^7.0.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-react-hooks": "^7.0.0",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@inertiajs/react": "^3.9.1",
        "@inertiajs/vite": "^3.9.1",
        "@laravel/passkeys": "^0.4.0",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-collapsible": "^1.2.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
