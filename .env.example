APP_NAME=Archivum
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Set this only when something else terminates TLS in front of the app, and only
# when the app cannot be reached except through it: a directly exposed
# installation that trusts every proxy lets any client forge its own address and
# walk past the login throttle. `*` for a container stack, or a comma-separated
# list. See docs/deployment.md.
# TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=archivum
DB_USERNAME=root
DB_PASSWORD=

# Initial admin user, created by `php artisan db:seed`. Leave ADMIN_PASSWORD
# empty to have one generated and printed during seeding.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# When false, the installation uses a single default Workspace and hides
# workspace creation/switching.
MULTI_WORKSPACE_ENABLED=true
DEFAULT_WORKSPACE_NAME="Default Workspace"

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Deliberately left on the database while cache and sessions moved to Redis.
# The queue holds the app's real work — exports and attachment text extraction
# — and a Redis without persistence loses it on a restart, which strands an
# attachment as "queued" forever. The database survives and is what gets
# backed up anyway.
QUEUE_CONNECTION=database

# Seconds before the queue decides a reserved job was lost and hands it to
# another worker. It MUST stay above the longest job's timeout or long OCR runs
# twice at once; the default derives from the OCR settings below, so leave it
# unset unless you know why you are changing it. See QueueTimeoutTest.
# DB_QUEUE_RETRY_AFTER=

CACHE_STORE=redis
# CACHE_PREFIX=

# Scout search engine. "database" runs LIKE queries against the model's own
# table — no separate search index, no external service required.
SCOUT_DRIVER=database

MEMCACHED_HOST=127.0.0.1

# Running through Sail or compose, this and DB_HOST above are the service
# names — `redis` and `mysql` — not 127.0.0.1.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Disk used to store Document attachments. Defaults to the private "local"
# disk. Set to "s3" (with the AWS_* vars above, pointed at AWS S3 or a
# MinIO-compatible endpoint) for non-local deployments.
ATTACHMENTS_DISK=local

# Attachment text extraction. A PDF's embedded text layer is read directly;
# scans and photos fall back to OCR. Needs the `tesseract` binary with a
# language pack per configured language, and `pdftotext` from poppler-utils —
# both are in this project's Docker image. Without them, uploads still work
# and attachments are simply marked as unavailable for extraction.
OCR_ENABLED=true
OCR_LANGUAGES=por+eng
# OCR_MIN_TEXT_LENGTH=100
# OCR_MAX_PAGES=20
# OCR_DPI=300
# OCR_TIMEOUT=120

# How long the whole extraction job may run. Derived from OCR_MAX_PAGES and
# OCR_TIMEOUT when unset, which is almost always what you want — the queue's
# retry window and the production worker's --timeout are derived from the same
# value, so overriding it here moves all three together.
# OCR_JOB_TIMEOUT=

# How long a "scan with your phone" QR pairing session stays valid.
# CAPTURE_SESSION_TTL_MINUTES=10

# Duplicate detection over extracted text. The distance is how many bits of a
# 64-bit fingerprint may differ before two attachments stop being "the same
# document"; the minimum is how much text has to be there to fingerprint at all.
# INTAKE_DUPLICATE_MAX_DISTANCE=20
# INTAKE_DUPLICATE_MIN_SHINGLES=20

# Which number comes first in a date written 03/04/2026: day or month. The only
# country-specific setting left in reading a document — everything else is
# recognised by the words around it, in the languages configured for the app
# (see lang/{locale}/intake.php).
# INTAKE_DATE_ORDER=day

# How many documents must write the same words in front of the same kind of
# value before that phrase is offered to a workspace admin as a label the
# reader could use. Nothing enters the vocabulary unaccepted; this only decides
# how much agreement is needed before the question is asked.
# INTAKE_LABEL_MIN_SUPPORT=3

# Public demo mode. A scheduled task drops every record and deletes every
# uploaded file each night, reseeding a small sample archive. Off unless BOTH
# of the first two are set, and `php artisan demo:reset` refuses to run
# otherwise — DEMO_RESET_CONFIRM must repeat this installation's own APP_URL,
# so a .env copied from a demo cannot wipe a real one. See docs/deployment.md.
# DEMO_MODE=false
# DEMO_RESET_CONFIRM=
# DEMO_RESET_AT=04:00
# DEMO_EMAIL=demo@archivum.example
# DEMO_PASSWORD=demo1234

VITE_APP_NAME="${APP_NAME}"
